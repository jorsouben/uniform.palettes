// Place your key bindings in this file to override the defaults
[
  // Insert native pipe |> in R files
  {
    "key": "ctrl+shift+m",
    "command": "type",
    "args": {
      "text": " |> "
    },
    "when": "editorTextFocus && editorLangId == 'r'"
  },
  // Insert native pipe |> in radian terminal
  {
    "key": "ctrl+shift+m",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": " |> "
    },
    "when": "terminalFocus"
  },
  // Reformat selected code (like Ctrl+Shift+A in RStudio)
  {
    "key": "ctrl+shift+a",
    "command": "editor.action.formatSelection",
    "when": "editorHasSelection && editorLangId == 'r'"
  },
  // Insert assignment operator <- in R files
  {
    "key": "alt+-",
    "command": "type",
    "args": {
      "text": " <- "
    },
    "when": "editorTextFocus && editorLangId == 'r'"
  },
  // Run code chunk in R files
  {
    "key": "ctrl+enter",
    "command": "r.runSelection",
    "when": "editorTextFocus && editorLangId == 'r'"
  }
]
